{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"overrides": [
		{
			"files": ["*"],
			"options": {
				"printWidth": 80
			}
		}
	],
	"sortPackageJson": true,
	"sortImports": {
		"newlinesBetween": false,
		"order": "asc",
		"ignoreCase": true,
		"groups": [
			"type-import",
			["value-builtin", "value-external"],
			"type-internal",
			"value-internal",
			["type-parent", "type-sibling", "type-index"],
			["value-parent", "value-sibling", "value-index"],
			"unknown"
		]
	}
}
